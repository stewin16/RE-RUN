theme_override_styles/panel = SubResource("StyleBoxFlat_pixel_panel")

[node name="VBox" type="VBoxContainer" parent="WinMenu/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 14.0
offset_top = 10.0
offset_right = -14.0
offset_bottom = -10.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 6
alignment = 1

[node name="Title" type="Label" parent="WinMenu/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.2, 0.95, 0.5, 1)
theme_override_colors/font_outline_color = Color(0.0941176, 0.0784314, 0.145098, 1)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 18
text = "🏆 LEVEL PASSED! 🏆"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="WinMenu/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 10
text = "FINAL EXAM CLEARED! GRADE: A+"
horizontal_alignment = 1

[node name="StatsLabel" type="Label" parent="WinMenu/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.9, 1, 1)
theme_override_font_sizes/font_size = 9
text = "Score: 000000 | Coins: 00"
horizontal_alignment = 1

[node name="ButtonContainer" type="HBoxContainer" parent="WinMenu/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="NextLevelBtn" type="Button" parent="WinMenu/Panel/VBox/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 11
text = "NEXT LEVEL"

[node name="MenuBtn" type="Button" parent="WinMenu/Panel/VBox/ButtonContainer"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
theme_override_font_sizes/font_size = 11
text = "MENU"

[node name="ClickSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_clicksfx")

[node name="HighscoreSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_hssfx")

[node name="QuizCorrectSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_quizcorrect")

[node name="QuizWrongSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("6_quizwrong")

[node name="HintUsedSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("7_hintused")

[node name="FactChimeSFX" type="AudioStreamPlayer" parent="."]
stream = ExtResource("8_factchime")

